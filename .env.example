# Connection details for the existing external PostgreSQL server.
# Copy this file to .env and fill in real values — .env is gitignored.
DB_HOST=your-postgres-host
DB_PORT=5432
DB_NAME=nj2pc_oem
DB_USER=nj2pc_oem
DB_PASSWORD=changeme

# Secret used to sign JWTs. Use a long random string in any real environment.
JWT_SECRET=change-this-to-a-long-random-value
